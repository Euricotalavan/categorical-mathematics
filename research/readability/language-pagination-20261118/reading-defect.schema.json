  "allOf": [
    {
      "if": {
        "properties": {
          "finding_status": {
            "const": "confirmed"
          }
        }
      },
      "then": {
        "properties": {
          "observed_evidence": {
            "minItems": 1
          },
          "evidence_tags": {
            "contains": {
              "const": "confirmed"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "finding_status": {
            "const": "defect_candidate"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_tags": {
            "contains": {
              "const": "defect_candidate"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "keep"
          }
        }
      },
      "then": {
        "properties": {
          "finding_status": {
            "const": "KEEP"
          },
          "disposition": {
            "const": "KEEP"
          },
          "proposed_change": {
            "properties": {
              "action": {
                "const": "KEEP"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "mathematics": {
                "properties": {
                  "status": {
                    "const": "safe_math_only"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence_tags": {
            "contains": {
              "const": "safe_math_only"
            }
          },
          "verification": {
            "properties": {
              "mathematics": {
                "properties": {
                  "obligation_ids": {
                    "minItems": 1
                  },
                  "evidence_ids": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "human_outcome": {
                "properties": {
                  "status": {
                    "const": "human_outcome_unknown"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evidence_tags": {
            "contains": {
              "const": "human_outcome_unknown"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposed_change": {
            "properties": {
              "action": {
                "const": "LAYOUT_ONLY"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "proposed_change": {
            "properties": {
              "changes_mathematical_semantics": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "RESOLVED_AND_RECHECKED"
          }
        }
      },
      "then": {
        "properties": {
          "recheck": {
            "properties": {
              "status": {
                "const": "completed_within_scope"
              },
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "mathematics": {
                "properties": {
                  "status": {
                    "const": "safe_math_only"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "proposed_change": {
            "properties": {
              "changes_mathematical_semantics": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
